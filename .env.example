# ==============================================================================
# Guia de Ensino — Variáveis de Ambiente de Exemplo (.env.example)
# NUNCA insira valores reais de credenciais ou segredos neste arquivo ou no git.
# ==============================================================================

# Configurações do Ambiente
NODE_ENV=development
PORT=3000
APP_ENV=local

# Banco de Dados Remoto (PostgreSQL - Backend Sync)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=guia_user
DATABASE_PASSWORD=your_secure_password_here
DATABASE_NAME=guia_de_ensino_db
DATABASE_SSL=false

# Autenticação e Criptografia
JWT_SECRET=your_jwt_secret_min_32_characters_here
JWT_EXPIRATION=7d

# Provedores de Inteligência Artificial (Configurados exclusivamente no Backend)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_TOKENS=2048

# Limites e Políticas de Uso da IA
AI_DAILY_QUOTA_PER_USER=50
AI_RATE_LIMIT_PER_MINUTE=10
