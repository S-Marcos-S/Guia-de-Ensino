# Ambiente e Servidor
NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=guia_user
DATABASE_PASSWORD=guia_password
DATABASE_NAME=guia_de_ensino_db
